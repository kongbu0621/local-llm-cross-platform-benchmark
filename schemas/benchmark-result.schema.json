{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kongbu0621/local-llm-cross-platform-benchmark/schemas/benchmark-result.schema.json",
  "title": "Local LLM Benchmark Result",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "suite_id",
    "tested_at",
    "evidence_level",
    "comparison_mode",
    "hardware",
    "model",
    "runtime",
    "workload",
    "measurements",
    "stability"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "tested_at": {"type": "string", "format": "date-time"},
    "evidence_level": {"enum": ["A", "B", "C"]},
    "result_status": {"enum": ["valid", "superseded", "invalidated"]},
    "comparison_mode": {"enum": ["strict_comparable", "platform_optimized", "community_reference"]},
    "hardware": {
      "type": "object",
      "required": ["node_ids", "node_count"],
      "properties": {
        "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "node_count": {"type": "integer", "minimum": 1},
        "topology": {"type": ["string", "null"]},
        "interconnect": {"type": ["string", "null"]},
        "tp_size": {"type": ["integer", "null"], "minimum": 1},
        "dp_size": {"type": ["integer", "null"], "minimum": 1},
        "ep_size": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["repo", "revision", "weight_precision"],
      "properties": {
        "repo": {"type": "string"},
        "revision": {"type": "string"},
        "weight_precision": {"type": "string"},
        "kv_precision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "chat_template_sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "optimization_stack": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": ["kind", "actual_input_tokens", "actual_output_tokens", "concurrency", "cache_state"],
      "properties": {
        "kind": {"type": "string"},
        "dataset_id": {"type": ["string", "null"]},
        "dataset_revision": {"type": ["string", "null"]},
        "prompt_sha256": {"type": ["string", "null"]},
        "configured_context_tokens": {"type": ["integer", "null"], "minimum": 1},
        "actual_input_tokens": {"type": "integer", "minimum": 0},
        "actual_output_tokens": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "cache_state": {"enum": ["cold", "warm", "prefix_cache", "mixed"]},
        "reasoning_mode": {"type": ["string", "null"]},
        "sampling": {"type": "object"}
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "properties": {
        "pp_tps": {"type": ["number", "null"], "minimum": 0},
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "decode_tps": {"type": ["number", "null"], "minimum": 0},
        "e2e_wall_ms": {"type": ["number", "null"], "minimum": 0},
        "inter_token_p50_ms": {"type": ["number", "null"], "minimum": 0},
        "inter_token_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "inter_token_p99_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_device_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_host_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "kv_cache_bytes": {"type": ["integer", "null"], "minimum": 0},
        "avg_power_w": {"type": ["number", "null"], "minimum": 0},
        "peak_power_w": {"type": ["number", "null"], "minimum": 0},
        "peak_temperature_c": {"type": ["number", "null"]},
        "quality": {"type": "object"},
        "measurement_method": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "stability": {
      "type": "object",
      "required": ["completed"],
      "properties": {
        "completed": {"type": "boolean"},
        "error_class": {"type": ["string", "null"]},
        "early_eos": {"type": "boolean"},
        "repetitive_output": {"type": "boolean"},
        "gibberish": {"type": "boolean"},
        "oom": {"type": "boolean"},
        "server_crash": {"type": "boolean"},
        "timeout": {"type": "boolean"},
        "context_truncated": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "environment_snapshot": {"type": ["string", "null"]},
        "raw_log": {"type": ["string", "null"]},
        "result_sha256": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
