{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kongbu0621/local-llm-cross-platform-benchmark/schemas/model-intelligence.schema.json",
  "title": "Model Intelligence Registry",
  "type": "object",
  "required": ["schema_version", "as_of", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id", "model_family", "model_variant", "revision", "license",
          "role_tags", "lifecycle", "test_priority", "quality_status",
          "quality_evidence_confidence", "hardware_evidence_confidence",
          "popularity", "momentum", "hardware_fit_summary", "source_refs"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "model_variant": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["quality_flagship", "production_sweet_spot", "coding_specialist", "long_context_specialist", "classic_reference", "emerging_hot"]}
          },
          "lifecycle": {"enum": ["WATCH", "CANDIDATE", "RUNTIME_QUALIFIED", "PERFORMANCE_QUALIFIED", "QUALITY_QUALIFIED", "AGENT_QUALIFIED", "PRODUCTION_QUALIFIED", "RECOMMENDED", "REFERENCE", "REJECTED", "DEPRECATED", "SUPERSEDED"]},
          "test_priority": {"enum": ["P0", "P1", "P2", "WATCH"]},
          "quality_status": {"enum": ["QUALIFIED", "CONDITIONAL", "NOT_QUALIFIED", "OPEN"]},
          "quality_evidence_confidence": {"enum": ["FIRST_PARTY_MEASURED", "REPRODUCIBLE_EXTERNAL", "STRONG_EXTERNAL", "COMMUNITY", "VENDOR_CLAIM", "UNKNOWN"]},
          "hardware_evidence_confidence": {"enum": ["FIRST_PARTY_MEASURED", "REPRODUCIBLE_EXTERNAL", "STRONG_EXTERNAL", "COMMUNITY", "VENDOR_CLAIM", "UNKNOWN"]},
          "popularity": {"type": ["number", "null"], "minimum": 0},
          "momentum": {"type": ["number", "null"]},
          "hardware_fit_summary": {"type": "object", "additionalProperties": {"enum": ["EXCELLENT", "GOOD", "FAIR", "WEAK", "UNSUITABLE", "CONDITIONAL", "OPEN"]}},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "production_qualification_ref": {"type": ["string", "null"]},
          "recommendation_confidence": {"type": ["string", "null"], "enum": ["HIGH", "MEDIUM", "LOW", "OPEN", null]},
          "superseded_by": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
