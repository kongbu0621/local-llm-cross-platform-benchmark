{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kongbu0621/local-llm-cross-platform-benchmark/schemas/agentic-coding-evidence.schema.json",
  "title": "External Agentic Coding Evidence Ledger",
  "type": "object",
  "required": ["schema_version", "as_of", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id", "model_family", "model_variant", "hardware_topology",
          "runtime", "agent_harness", "task_suite", "run_count",
          "hidden_tests_passed", "hidden_tests_total", "result_scope",
          "evidence_confidence", "source_refs", "caveats"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "model_variant": {"type": "string", "minLength": 1},
          "hardware_topology": {"type": "string", "minLength": 1},
          "runtime": {"type": "string", "minLength": 1},
          "agent_harness": {"type": "string", "minLength": 1},
          "task_suite": {"type": "string", "minLength": 1},
          "run_count": {"type": "integer", "minimum": 1},
          "hidden_tests_passed": {"type": "integer", "minimum": 0},
          "hidden_tests_total": {"type": "integer", "minimum": 1},
          "wall_clock_seconds": {"type": ["number", "null"], "minimum": 0},
          "tool_calls": {"type": ["integer", "null"], "minimum": 0},
          "own_tests_written": {"type": ["integer", "null"], "minimum": 0},
          "generation_tok_s": {"type": ["number", "null"], "minimum": 0},
          "e2e_tok_s": {"type": ["number", "null"], "minimum": 0},
          "configured_context_tokens": {"type": ["integer", "null"], "minimum": 1},
          "observed_repeat_min_hidden_tests": {"type": ["integer", "null"], "minimum": 0},
          "observed_repeat_max_hidden_tests": {"type": ["integer", "null"], "minimum": 0},
          "result_scope": {"enum": ["AGENTIC_CODING_TASKS", "TOOL_PROTOCOL_SMOKE", "NEGATIVE_CONFIGURATION_EVIDENCE"]},
          "evidence_confidence": {"enum": ["REPRODUCIBLE_EXTERNAL", "STRONG_EXTERNAL", "COMMUNITY"]},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^https://"}
          },
          "caveats": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
